// Backend Gil's English School — Node.js + Prisma (confirmé avec OTK, remplace le plan initial Spring Boot).
// SQLite en local pour aller vite ; il suffira de changer `provider` + `DATABASE_URL`
// pour passer sur PostgreSQL en production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Student {
  id           String       @id @default(cuid())
  fullName     String
  whatsapp     String
  level        String?
  grammarScore Float?
  topicScore   Float?
  audioScore   Float?
  totalScore   Float?
  status       String       @default("PENDING_TEST") // PENDING_TEST | PENDING_PAYMENT | ACTIVE
  paymentLink  PaymentLink?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model PaymentLink {
  id          String   @id @default(cuid())
  token       String   @unique
  student     Student  @relation(fields: [studentId], references: [id])
  studentId   String   @unique
  studentName String
  amount      Int // 25000
  status      String   @default("PENDING") // PENDING | PAID
  createdAt   DateTime @default(now())
}
